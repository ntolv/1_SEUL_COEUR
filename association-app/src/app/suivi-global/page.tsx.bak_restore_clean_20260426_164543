                            {groupe.telephone || "Tï¿½lï¿½phone non renseignï¿½"}
                          </div>
                        </div>

                        <span
                          className={`inline-flex rounded-full px-2.5 py-1 text-xs ${
                            groupe.typePersonne === "MEMBRE"
                              ? "bg-cyan-400/20 text-cyan-300"
