"use client";

import { useEffect, useMemo, useState } from "react";
import AppShell from "@/components/layout/AppShell";
import { supabase } from "@/lib/supabaseClient";

type MembreRow = {
  id: string;
  nom_complet: string | null;
  telephone: string | null;
  email?: string | null;
  photo_url?: string | null;
  role?: string | null;
  statut_actif?: boolean | null;
};

type ProfilRow = {
  id: string;
  membre_id: string | null;
  preinscription_id: string | null;
  nom_affichage: string;
  telephone: string | null;
  source: "membre" | "preinscription";
};

type LigneMembre = {
  membre_id: string;
  montant_encaisse: number;
  statut: string;
};

type LignePreinscrit = {
  profil_id: string;
  nom_affichage?: string | null;
  montant_encaisse: number;
  statut: string;
};

type MeRow = {
  id?: string;
  membre_id?: string;
  role?: string;
};

type SituationHybrideRow = {
  id: string;
  nom: string;
  type: "Membre" | "Préinscrit";
  total_encaisse: number;
  retards: number;
  membre_id: string | null;
  telephone: string | null;
  photo_url: string | null;
};

const MANAGER_ROLES = ["admin", "president", "tresorier"];

export default function MembresPage() {
  const [membres, setMembres] = useState<MembreRow[]>([]);
  const [profils, setProfils] = useState<ProfilRow[]>([]);
  const [lignesMembres, setLignesMembres] = useState<LigneMembre[]>([]);
  const [lignesPreinscrits, setLignesPreinscrits] = useState<LignePreinscrit[]>([]);
  const [me, setMe] = useState<MeRow | null>(null);
  const [recherche, setRecherche] = useState("");

  useEffect(() => {
    charger();
  }, []);

  async function charger() {
    const moisCourant = new Date().toISOString().slice(0, 7) + "-01";

    const [
      membresRes,
      profilsRes,
      lignesMembresRes,
      lignesPreinscritsRes,
      meRes,
    ] = await Promise.all([
      supabase.from("membres").select("*").order("nom_complet", { ascending: true }),
      supabase
        .from("encaissement_profils")
        .select("id, membre_id, preinscription_id, nom_affichage, telephone, source")
        .order("nom_affichage", { ascending: true }),
      supabase
        .from("v_encaissements_suivi")
        .select("membre_id, montant_encaisse, statut")
        .eq("mois", moisCourant),
      supabase
        .from("v_encaissements_preinscrits_suivi")
        .select("profil_id, nom_affichage, montant_encaisse, statut")
        .eq("mois", moisCourant),
      supabase.rpc("fn_me"),
    ]);

    setMembres((membresRes.data || []) as MembreRow[]);
    setProfils((profilsRes.data || []) as ProfilRow[]);
    setLignesMembres((lignesMembresRes.data || []) as LigneMembre[]);
    setLignesPreinscrits((lignesPreinscritsRes.data || []) as LignePreinscrit[]);

    let meData: MeRow | null = null;
    if (Array.isArray(meRes.data)) {
      meData = (meRes.data[0] || null) as MeRow | null;
    } else if (meRes.data) {
      meData = meRes.data as MeRow;
    }
    setMe(meData);
  }

  async function uploadPhoto(file: File, membreId: string) {
    const filePath = `${membreId}/${Date.now()}-${file.name}`;

    const { error: uploadError } = await supabase.storage
      .from("photos-membres")
      .upload(filePath, file, { upsert: true });

    if (uploadError) {
      alert(uploadError.message);
      return;
    }

    const { data } = supabase.storage
      .from("photos-membres")
      .getPublicUrl(filePath);

    const publicUrl = data.publicUrl;

    await supabase
      .from("membres")
      .update({ photo_url: publicUrl })
      .eq("id", membreId);

    charger();
  }

  function normalizeNom(value: string | null | undefined) {
    return (value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/\s+/g, " ")
      .trim()
      .toLowerCase();
  }

  const myRole = useMemo(() => (me?.role || "").toLowerCase(), [me]);
  const isManager = useMemo(() => MANAGER_ROLES.includes(myRole), [myRole]);

  const situationHybride = useMemo(() => {
    const byName = new Map<string, SituationHybrideRow>();

    // 1) priorité absolue aux membres
    membres.forEach((membre) => {
      const nom = membre.nom_complet?.trim() || "Membre";
      const nomKey = normalizeNom(nom);

      if (!nomKey) return;

      if (!byName.has(nomKey)) {
        byName.set(nomKey, {
          id: membre.id,
          nom,
          type: "Membre",
          total_encaisse: 0,
          retards: 0,
          membre_id: membre.id,
          telephone: membre.telephone || null,
          photo_url: membre.photo_url || null,
        });
      }
    });

    // 2) compléter les totaux des membres
    lignesMembres.forEach((ligne) => {
      const membre = membres.find((m) => m.id === ligne.membre_id);
      const profil = profils.find((p) => p.membre_id === ligne.membre_id);
      const nom = membre?.nom_complet?.trim() || profil?.nom_affichage?.trim() || "Membre";
      const nomKey = normalizeNom(nom);

      if (!nomKey) return;

      if (!byName.has(nomKey)) {
        byName.set(nomKey, {
          id: ligne.membre_id,
          nom,
          type: "Membre",
          total_encaisse: 0,
          retards: 0,
          membre_id: ligne.membre_id,
          telephone: membre?.telephone || profil?.telephone || null,
          photo_url: membre?.photo_url || null,
        });
      }

      const item = byName.get(nomKey)!;
      item.total_encaisse += Number(ligne.montant_encaisse || 0);
      if (ligne.statut === "retard") item.retards += 1;
    });

    // 3) ajouter les préinscrits seulement si aucun membre du même nom n'existe
    profils
      .filter((p) => !p.membre_id)
      .forEach((profil) => {
        const nom = profil.nom_affichage?.trim() || "Préinscrit";
        const nomKey = normalizeNom(nom);

        if (!nomKey) return;
        if (byName.has(nomKey)) return;

        byName.set(nomKey, {
          id: profil.id,
          nom,
          type: "Préinscrit",
          total_encaisse: 0,
          retards: 0,
          membre_id: null,
          telephone: profil.telephone || null,
          photo_url: null,
        });
      });

    // 4) compléter les totaux des préinscrits, sans créer de doublon si même nom qu'un membre
    lignesPreinscrits.forEach((ligne) => {
      const profil = profils.find((p) => p.id === ligne.profil_id);
      const nom = profil?.nom_affichage?.trim() || ligne.nom_affichage?.trim() || "Préinscrit";
      const nomKey = normalizeNom(nom);

      if (!nomKey) return;

      const item = byName.get(nomKey);

      // si le nom correspond déjà à un membre, on ignore complètement le préinscrit
      if (item && item.type === "Membre") {
        return;
      }

      if (!item) {
        byName.set(nomKey, {
          id: ligne.profil_id,
          nom,
          type: "Préinscrit",
          total_encaisse: 0,
          retards: 0,
          membre_id: null,
          telephone: profil?.telephone || null,
          photo_url: null,
        });
      }

      const current = byName.get(nomKey)!;
      current.total_encaisse += Number(ligne.montant_encaisse || 0);
      if (ligne.statut === "retard") current.retards += 1;
    });

    return Array.from(byName.values()).sort((a, b) =>
      a.nom.localeCompare(b.nom, "fr", { sensitivity: "base" })
    );
  }, [membres, profils, lignesMembres, lignesPreinscrits]);

  const situationFiltree = useMemo(() => {
    const q = recherche.trim().toLowerCase();
    if (!q) return situationHybride;

    return situationHybride.filter((item) => {
      return (
        item.nom.toLowerCase().includes(q) ||
        (item.telephone || "").toLowerCase().includes(q) ||
        item.type.toLowerCase().includes(q)
      );
    });
  }, [situationHybride, recherche]);

  function formatEuro(value: number | string | null | undefined) {
    return new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    }).format(Number(value || 0));
  }

  return (
    <AppShell>
      <div className="space-y-6 text-white">
        {isManager && (
          <section className="rounded-3xl border border-white/10 bg-slate-900/60 p-5">
            <div className="mb-4 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
              <div>
                <h2 className="text-xl font-semibold tracking-tight">
                  Situation globale contributive
                </h2>
                <p className="mt-1 text-sm text-slate-400">
                  Vue hybride des membres et préinscrits, sans doublons
                </p>
              </div>

              <div className="w-full lg:w-80">
                <label className="mb-2 block text-sm font-medium text-slate-300">
                  Rechercher
                </label>
                <input
                  type="text"
                  value={recherche}
                  onChange={(e) => setRecherche(e.target.value)}
                  placeholder="Nom, téléphone, type..."
                  className="w-full rounded-2xl border border-white/10 bg-slate-800 px-4 py-3 text-white outline-none"
                />
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full min-w-[860px] text-sm">
                <thead className="bg-white/5 text-slate-300">
                  <tr>
                    <th className="px-4 py-3 text-left font-medium">Nom</th>
                    <th className="px-4 py-3 text-center font-medium">Type</th>
                    <th className="px-4 py-3 text-center font-medium">Téléphone</th>
                    <th className="px-4 py-3 text-center font-medium">Total encaissé</th>
                    <th className="px-4 py-3 text-center font-medium">Rubriques en retard</th>
                    <th className="px-4 py-3 text-center font-medium">Statut global</th>
                  </tr>
                </thead>
                <tbody>
                  {situationFiltree.map((item) => (
                    <tr key={item.id} className="border-t border-white/5">
                      <td className="px-4 py-3 text-white">{item.nom}</td>
                      <td className="px-4 py-3 text-center text-slate-300">{item.type}</td>
                      <td className="px-4 py-3 text-center text-slate-300">
                        {item.telephone || "-"}
                      </td>
                      <td className="px-4 py-3 text-center text-white">
                        {formatEuro(item.total_encaisse)}
                      </td>
                      <td className="px-4 py-3 text-center">
                        <span className={item.retards > 0 ? "text-red-400" : "text-emerald-400"}>
                          {item.retards}
                        </span>
                      </td>
                      <td className="px-4 py-3 text-center">
                        <span
                          className={
                            "inline-flex rounded-full px-2.5 py-1 text-xs font-medium " +
                            (item.retards > 0
                              ? "border border-red-400/20 bg-red-500/10 text-red-300"
                              : "border border-emerald-400/20 bg-emerald-500/10 text-emerald-300")
                          }
                        >
                          {item.retards > 0 ? "Retard" : "À jour / neutre"}
                        </span>
                      </td>
                    </tr>
                  ))}

                  {situationFiltree.length === 0 && (
                    <tr>
                      <td colSpan={6} className="px-4 py-10 text-center text-slate-400">
                        Aucune donnée contributive trouvée.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {membres.map((m) => (
            <div key={m.id} className="rounded-2xl bg-slate-900 p-4">
              <div className="flex items-center gap-3">
                {m.photo_url ? (
                  <img
                    src={m.photo_url}
                    className="h-12 w-12 rounded-xl object-cover"
                    alt={m.nom_complet || "Photo membre"}
                  />
                ) : (
                  <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-700">
                    📷
                  </div>
                )}

                <div className="min-w-0">
                  <div className="truncate font-semibold">{m.nom_complet}</div>
                  <div className="text-sm text-slate-400">{m.telephone}</div>
                </div>
              </div>

              <label className="mt-3 block cursor-pointer text-sm text-cyan-400">
                Importer photo
                <input
                  type="file"
                  className="hidden"
                  onChange={(e) => {
                    if (e.target.files?.[0]) {
                      uploadPhoto(e.target.files[0], m.id);
                    }
                  }}
                />
              </label>
            </div>
          ))}
        </div>
      </div>
    </AppShell>
  );
}
